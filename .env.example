# NIEL Platform Configuration

# Map Provider & Basemap Style
VITE_MAP_PROVIDER=carto_satellite
VITE_MAP_STYLE_URL=
VITE_MAP_API_KEY=

# Backend REST API Endpoint (NER Platform Backend)
VITE_API_BASE_URL=http://localhost:5000/api

# Real-time Socket.io Telemetry & Alert Stream (backend Socket.io server on :5000)
VITE_LIVE_WS_URL=http://localhost:5000

# Automated Weather Monitoring (src/services/weatherMonitor.js)
# -----------------------------------------------------------
# When enabled the service polls every 15 minutes (configurable) and
# auto-updates road status via PostGIS spatial correlation.
WEATHER_MONITOR_ENABLED=true
OPENWEATHER_API_KEY=                          # required for real precipitation data (One Call 3.0)
# OPENWEATHER_API_URL=https://api.openweathermap.org/data/3.0/onecall
# WEATHER_POLL_MS=900000                       # polling interval (default 15 min)
# WEATHER_API_DAILY_BUDGET=900                 # safe rate-limit ceiling (One Call free = 1000/day)
# WEATHER_API_TIMEOUT_MS=6000                  # per-request timeout (ms)
# WEATHER_CORRELATION_RADIUS_KM=120            # max radius (km) from district centroid to match roads
# WEATHER_RISKY_THRESHOLD_MMH=30               # rain rate that triggers OPEN -> RISKY
# WEATHER_BLOCKED_THRESHOLD_MMH=50             # rain rate that triggers OPEN/RISKY -> BLOCKED
# WEATHER_CLEAR_SUSTAINED_MS=7200000           # sustained dry window before downgrade (default 2 h)
# WEATHER_FORECAST_WINDOW_HRS=3                # forecast hours factored into the escalation matrix
